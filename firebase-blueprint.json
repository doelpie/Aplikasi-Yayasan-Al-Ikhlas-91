{
  "entities": {
    "Member": {
      "title": "Member",
      "description": "Anggota Yayasan Al Ikhlas Sembilan Satu",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "ID unik anggota",
          "maxLength": 64
        },
        "regNumber": {
          "type": "string",
          "description": "Nomor Registrasi Anggota",
          "maxLength": 100
        },
        "nik": {
          "type": "string",
          "description": "Nomor KTP atau KIA (16 digit)",
          "maxLength": 50
        },
        "nama": {
          "type": "string",
          "description": "Nama Lengkap Sesuai KTP",
          "maxLength": 250
        },
        "alamat": {
          "type": "string",
          "description": "Alamat Tempat Tinggal Lengkap",
          "maxLength": 1000
        },
        "noHp": {
          "type": "string",
          "description": "Nomor WhatsApp atau Telepon",
          "maxLength": 50
        },
        "noKk": {
          "type": "string",
          "description": "Nomor Kartu Keluarga",
          "maxLength": 50
        },
        "peranKeluarga": {
          "type": "string",
          "enum": ["kepala_keluarga", "istri", "anak"],
          "description": "Status dalam keluarga"
        },
        "kepalaKeluargaId": {
          "type": "string",
          "description": "ID Kepala Keluarga terkait jika istri atau anak",
          "maxLength": 64
        },
        "namaKepalaKeluarga": {
          "type": "string",
          "description": "Nama Kepala Keluarga",
          "maxLength": 250
        },
        "tempatTanggalLahir": {
          "type": "string",
          "description": "Tempat dan Tanggal Lahir",
          "maxLength": 200
        },
        "jumlahKeluarga": {
          "type": "number",
          "description": "Jumlah jiwa dalam keluarga"
        },
        "email": {
          "type": "string",
          "description": "Email anggota",
          "maxLength": 200
        },
        "fotoUrl": {
          "type": "string",
          "description": "URL foto diri profil berbusana rapi dan syar'i (compressed)",
          "maxLength": 250000
        },
        "fotoName": {
          "type": "string",
          "description": "Nama file foto",
          "maxLength": 200
        },
        "ktpUrl": {
          "type": "string",
          "description": "URL lampiran foto/dokumen KTP (compressed)",
          "maxLength": 250000
        },
        "ktpName": {
          "type": "string",
          "description": "Nama file KTP",
          "maxLength": 200
        },
        "kkUrl": {
          "type": "string",
          "description": "URL lampiran foto/dokumen KK (compressed)",
          "maxLength": 250000
        },
        "kkName": {
          "type": "string",
          "description": "Nama file KK",
          "maxLength": 200
        },
        "status": {
          "type": "string",
          "enum": ["menunggu", "disetujui", "ditolak"],
          "description": "Status persetujuan admin"
        },
        "catatanPenolakan": {
          "type": "string",
          "description": "Alasan penolakan jika pendaftaran ditolak",
          "maxLength": 1000
        },
        "tanggalDaftar": {
          "type": "string",
          "description": "Tanggal pendaftaran format ISO",
          "maxLength": 100
        },
        "tanggalDisetujui": {
          "type": "string",
          "description": "Tanggal disetujui format ISO",
          "maxLength": 100
        }
      },
      "required": ["id", "nik", "nama", "alamat", "noHp", "noKk", "peranKeluarga", "status", "tanggalDaftar"]
    },
    "Notification": {
      "title": "Notification",
      "description": "Notifikasi Real-time perubahan status dan aktivitas anggota",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "ID unik notifikasi",
          "maxLength": 64
        },
        "memberId": {
          "type": "string",
          "description": "ID anggota yang bersangkutan",
          "maxLength": 64
        },
        "memberName": {
          "type": "string",
          "description": "Nama anggota terkait",
          "maxLength": 250
        },
        "type": {
          "type": "string",
          "enum": ["status_approved", "status_rejected", "new_registration", "data_updated"],
          "description": "Tipe kejadian notifikasi"
        },
        "message": {
          "type": "string",
          "description": "Pesan notifikasi",
          "maxLength": 1000
        },
        "timestamp": {
          "type": "string",
          "description": "Waktu notifikasi format ISO",
          "maxLength": 100
        },
        "read": {
          "type": "boolean",
          "description": "Status sudah dibaca"
        }
      },
      "required": ["id", "memberId", "memberName", "type", "message", "timestamp", "read"]
    },
    "Activity": {
      "title": "Activity",
      "description": "Jadwal dan Absensi Kegiatan Yayasan Al Ikhlas",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "ID unik kegiatan",
          "maxLength": 64
        },
        "judul": {
          "type": "string",
          "description": "Judul kegiatan",
          "maxLength": 250
        },
        "jenis": {
          "type": "string",
          "enum": ["rapat_pengurus", "pengajian_umum", "arisan"],
          "description": "Jenis kegiatan"
        },
        "tanggal": {
          "type": "string",
          "description": "Tanggal pelaksanaan kegiatan (YYYY-MM-DD)",
          "maxLength": 30
        },
        "jamMulai": {
          "type": "string",
          "description": "Jam mulai kegiatan",
          "maxLength": 20
        },
        "jamSelesai": {
          "type": "string",
          "description": "Jam selesai kegiatan",
          "maxLength": 20
        },
        "lokasi": {
          "type": "string",
          "description": "Lokasi pelaksanaan kegiatan",
          "maxLength": 300
        },
        "deskripsi": {
          "type": "string",
          "description": "Deskripsi agenda kegiatan",
          "maxLength": 2000
        },
        "createdAt": {
          "type": "string",
          "description": "Waktu pembuatan format ISO",
          "maxLength": 100
        },
        "updatedAt": {
          "type": "string",
          "description": "Waktu pembaruan format ISO",
          "maxLength": 100
        }
      },
      "required": ["id", "judul", "jenis", "tanggal", "jamMulai", "deskripsi", "createdAt", "updatedAt"]
    }
  },
  "firestore": {
    "/members/{memberId}": {
      "schema": "Member",
      "description": "Koleksi data anggota Yayasan Al Ikhlas Sembilan Satu"
    },
    "/notifications/{notificationId}": {
      "schema": "Notification",
      "description": "Koleksi notifikasi real-time sistem"
    },
    "/activities/{activityId}": {
      "schema": "Activity",
      "description": "Koleksi jadwal dan presensi kegiatan yayasan"
    }
  }
}
