{
  "entities": {
    "Member": {
      "title": "Member",
      "description": "Anggota Yayasan Al Ikhlas Sembilan Satu (sama persis antara members dan tempdatalama)",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "ID unik anggota",
          "maxLength": 64
        },
        "regNumber": {
          "type": "string",
          "description": "Nomor Registrasi Anggota",
          "maxLength": 100
        },
        "nik": {
          "type": "string",
          "description": "Nomor KTP atau KIA (16 digit)",
          "maxLength": 50
        },
        "nama": {
          "type": "string",
          "description": "Nama Lengkap Sesuai KTP",
          "maxLength": 250
        },
        "alamat": {
          "type": "string",
          "description": "Alamat Tempat Tinggal Lengkap",
          "maxLength": 1000
        },
        "noHp": {
          "type": "string",
          "description": "Nomor WhatsApp atau Telepon",
          "maxLength": 50
        },
        "noKk": {
          "type": "string",
          "description": "Nomor Kartu Keluarga",
          "maxLength": 50
        },
        "peranKeluarga": {
          "type": "string",
          "enum": ["kepala_keluarga", "istri", "anak"],
          "description": "Status dalam keluarga"
        },
        "kepalaKeluargaId": {
          "type": "string",
          "description": "ID Kepala Keluarga terkait jika istri atau anak",
          "maxLength": 64
        },
        "namaKepalaKeluarga": {
          "type": "string",
          "description": "Nama Kepala Keluarga",
          "maxLength": 250
        },
        "tempatTanggalLahir": {
          "type": "string",
          "description": "Tempat dan Tanggal Lahir",
          "maxLength": 200
        },
        "jumlahKeluarga": {
          "type": "number",
          "description": "Jumlah jiwa dalam keluarga"
        },
        "email": {
          "type": "string",
          "description": "Email anggota",
          "maxLength": 200
        },
        "fotoUrl": {
          "type": "string",
          "description": "URL foto diri profil berbusana rapi dan syar'i (compressed)",
          "maxLength": 350000
        },
        "fotoName": {
          "type": "string",
          "description": "Nama file foto",
          "maxLength": 200
        },
        "ktpUrl": {
          "type": "string",
          "description": "URL lampiran foto/dokumen KTP (compressed)",
          "maxLength": 350000
        },
        "ktpName": {
          "type": "string",
          "description": "Nama file KTP",
          "maxLength": 200
        },
        "kkUrl": {
          "type": "string",
          "description": "URL lampiran foto/dokumen KK (compressed)",
          "maxLength": 350000
        },
        "kkName": {
          "type": "string",
          "description": "Nama file KK",
          "maxLength": 200
        },
        "status": {
          "type": "string",
          "enum": ["menunggu", "disetujui", "ditolak"],
          "description": "Status persetujuan admin"
        },
        "catatanPenolakan": {
          "type": "string",
          "description": "Alasan penolakan jika pendaftaran ditolak",
          "maxLength": 1000
        },
        "tanggalDaftar": {
          "type": "string",
          "description": "Tanggal pendaftaran format ISO",
          "maxLength": 100
        },
        "tanggalDisetujui": {
          "type": "string",
          "description": "Tanggal disetujui format ISO",
          "maxLength": 100
        },
        "deletedAt": {
          "type": "string",
          "description": "Waktu data dihapus dan dipindahkan ke tempdatalama format ISO",
          "maxLength": 100
        },
        "deletedReason": {
          "type": "string",
          "description": "Alasan penghapusan data ke tempdatalama",
          "maxLength": 500
        }
      },
      "required": ["id", "nik", "nama", "alamat", "noHp", "noKk", "peranKeluarga", "status", "tanggalDaftar"]
    },
    "TempDataSebelumDaftar": {
      "title": "TempDataSebelumDaftar",
      "description": "Data sementara calon anggota yang sedang mengetik formulir pendaftaran (auto-sync setiap 5 detik) dengan keunikan perangkat",
      "type": "object",
      "properties": {
        "idtempdata": {
          "type": "string",
          "description": "ID unik data sementara berdasarkan IP/Location, Browser, Versi HP/OS, dan IMEI/Signature perangkat",
          "maxLength": 128
        },
        "ipLocation": {
          "type": "string",
          "description": "IP Address dan Lokasi / Zona Waktu pendaftar",
          "maxLength": 200
        },
        "browserType": {
          "type": "string",
          "description": "Tipe dan versi browser yang digunakan",
          "maxLength": 200
        },
        "deviceVersion": {
          "type": "string",
          "description": "Versi HP / Sistem Operasi dan model perangkat",
          "maxLength": 200
        },
        "deviceImei": {
          "type": "string",
          "description": "Identitas unik perangkat / IMEI signature",
          "maxLength": 128
        },
        "sourceForm": {
          "type": "string",
          "enum": ["halaman_daftar_publik", "halaman_admin"],
          "description": "Sumber formulir pendaftaran"
        },
        "statusDraft": {
          "type": "string",
          "enum": ["sedang_mengisi", "selesai_daftar"],
          "description": "Status pengisian draft pendaftaran"
        },
        "finalMemberId": {
          "type": "string",
          "description": "ID Anggota resmi setelah klik Daftar",
          "maxLength": 64
        },
        "regNumber": {
          "type": "string",
          "description": "Nomor Registrasi Anggota",
          "maxLength": 100
        },
        "nik": {
          "type": "string",
          "description": "Nomor KTP atau KIA yang sedang diketik",
          "maxLength": 50
        },
        "noKk": {
          "type": "string",
          "description": "Nomor Kartu Keluarga yang sedang diketik",
          "maxLength": 50
        },
        "nama": {
          "type": "string",
          "description": "Nama Lengkap yang sedang diketik",
          "maxLength": 250
        },
        "tempatTanggalLahir": {
          "type": "string",
          "description": "Tempat dan Tanggal Lahir",
          "maxLength": 200
        },
        "alamat": {
          "type": "string",
          "description": "Alamat Lengkap",
          "maxLength": 1000
        },
        "noHp": {
          "type": "string",
          "description": "Nomor WhatsApp atau Telepon",
          "maxLength": 50
        },
        "email": {
          "type": "string",
          "description": "Email calon anggota",
          "maxLength": 200
        },
        "peranKeluarga": {
          "type": "string",
          "enum": ["kepala_keluarga", "istri", "anak"],
          "description": "Status dalam keluarga"
        },
        "kepalaKeluargaId": {
          "type": "string",
          "description": "ID Kepala Keluarga terkait",
          "maxLength": 64
        },
        "namaKepalaKeluarga": {
          "type": "string",
          "description": "Nama Kepala Keluarga terkait",
          "maxLength": 250
        },
        "jumlahKeluarga": {
          "type": "number",
          "description": "Jumlah anggota keluarga"
        },
        "fotoUrl": {
          "type": "string",
          "description": "Foto diri yang diunggah sementara",
          "maxLength": 350000
        },
        "fotoName": {
          "type": "string",
          "description": "Nama file foto diri",
          "maxLength": 200
        },
        "ktpUrl": {
          "type": "string",
          "description": "Lampiran KTP sementara",
          "maxLength": 350000
        },
        "ktpName": {
          "type": "string",
          "description": "Nama file KTP",
          "maxLength": 200
        },
        "kkUrl": {
          "type": "string",
          "description": "Lampiran KK sementara",
          "maxLength": 350000
        },
        "kkName": {
          "type": "string",
          "description": "Nama file KK",
          "maxLength": 200
        },
        "status": {
          "type": "string",
          "enum": ["menunggu", "disetujui", "ditolak"],
          "description": "Target status pendaftaran"
        },
        "catatanPenolakan": {
          "type": "string",
          "description": "Catatan penolakan",
          "maxLength": 1000
        },
        "createdAt": {
          "type": "string",
          "description": "Waktu pertama kali mengetik format ISO",
          "maxLength": 100
        },
        "updatedAt": {
          "type": "string",
          "description": "Waktu sinkronisasi 5 detik terakhir format ISO",
          "maxLength": 100
        }
      },
      "required": ["idtempdata", "ipLocation", "browserType", "deviceVersion", "deviceImei", "sourceForm", "statusDraft", "createdAt", "updatedAt"]
    },
    "SystemCounter": {
      "title": "SystemCounter",
      "description": "Pelacak nomor urut ID anggota unik agar ID tidak pernah digunakan ulang",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "ID counter",
          "maxLength": 64
        },
        "lastNumber": {
          "type": "number",
          "description": "Nomor urut ID tertinggi terakhir yang pernah dialokasikan"
        },
        "updatedAt": {
          "type": "string",
          "description": "Waktu pembaruan terakhir format ISO",
          "maxLength": 100
        }
      },
      "required": ["id", "lastNumber", "updatedAt"]
    },
    "Notification": {
      "title": "Notification",
      "description": "Notifikasi Real-time perubahan status dan aktivitas anggota",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "ID unik notifikasi",
          "maxLength": 64
        },
        "memberId": {
          "type": "string",
          "description": "ID anggota yang bersangkutan",
          "maxLength": 64
        },
        "memberName": {
          "type": "string",
          "description": "Nama anggota terkait",
          "maxLength": 250
        },
        "type": {
          "type": "string",
          "enum": ["status_approved", "status_rejected", "new_registration", "data_updated"],
          "description": "Tipe kejadian notifikasi"
        },
        "message": {
          "type": "string",
          "description": "Pesan notifikasi",
          "maxLength": 1000
        },
        "timestamp": {
          "type": "string",
          "description": "Waktu notifikasi format ISO",
          "maxLength": 100
        },
        "read": {
          "type": "boolean",
          "description": "Status sudah dibaca"
        }
      },
      "required": ["id", "memberId", "memberName", "type", "message", "timestamp", "read"]
    },
    "Activity": {
      "title": "Activity",
      "description": "Jadwal dan Absensi Kegiatan Yayasan Al Ikhlas",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "ID unik kegiatan",
          "maxLength": 64
        },
        "judul": {
          "type": "string",
          "description": "Judul kegiatan",
          "maxLength": 250
        },
        "jenis": {
          "type": "string",
          "enum": ["rapat_pengurus", "pengajian_umum", "arisan"],
          "description": "Jenis kegiatan"
        },
        "tanggal": {
          "type": "string",
          "description": "Tanggal pelaksanaan kegiatan (YYYY-MM-DD)",
          "maxLength": 30
        },
        "jamMulai": {
          "type": "string",
          "description": "Jam mulai kegiatan",
          "maxLength": 20
        },
        "jamSelesai": {
          "type": "string",
          "description": "Jam selesai kegiatan",
          "maxLength": 20
        },
        "lokasi": {
          "type": "string",
          "description": "Lokasi pelaksanaan kegiatan",
          "maxLength": 300
        },
        "deskripsi": {
          "type": "string",
          "description": "Deskripsi agenda kegiatan",
          "maxLength": 2000
        },
        "createdAt": {
          "type": "string",
          "description": "Waktu pembuatan format ISO",
          "maxLength": 100
        },
        "updatedAt": {
          "type": "string",
          "description": "Waktu pembaruan format ISO",
          "maxLength": 100
        }
      },
      "required": ["id", "judul", "jenis", "tanggal", "jamMulai", "deskripsi", "createdAt", "updatedAt"]
    },
    "SystemLog": {
      "title": "SystemLog",
      "description": "Catatan seluruh aktivitas aplikasi, log sistem, operasi database Firestore, dan rekaman error",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "ID unik log",
          "maxLength": 64
        },
        "category": {
          "type": "string",
          "enum": ["DATABASE", "AUTH_SECURITY", "PENDAFTARAN", "ADMIN_ACTION", "PRESENSI", "SISTEM_ERROR"],
          "description": "Kategori log aktivitas/sistem"
        },
        "level": {
          "type": "string",
          "enum": ["INFO", "SUCCESS", "WARN", "ERROR"],
          "description": "Tingkat keparahan log"
        },
        "title": {
          "type": "string",
          "description": "Judul ringkas aktivitas/error",
          "maxLength": 250
        },
        "detail": {
          "type": "string",
          "description": "Rincian aktivitas atau pesan error",
          "maxLength": 3000
        },
        "timestamp": {
          "type": "string",
          "description": "Waktu log format ISO",
          "maxLength": 100
        },
        "source": {
          "type": "string",
          "description": "Asal komponen atau modul",
          "maxLength": 100
        }
      },
      "required": ["id", "category", "level", "title", "detail", "timestamp"]
    }
  },
  "firestore": {
    "/members/{memberId}": {
      "schema": "Member",
      "description": "Koleksi data anggota aktif Yayasan Al Ikhlas Sembilan Satu"
    },
    "/tempdatamenunggu/{memberId}": {
      "schema": "Member",
      "description": "Koleksi tempat tampung sementara data pendaftar baru yang menunggu persetujuan admin beserta seluruh field lengkap"
    },
    "/tempdatalama/{memberId}": {
      "schema": "Member",
      "description": "Koleksi sementara penampung data anggota yang terhapus beserta seluruh field lengkap agar dapat dipulihkan kembali atas konfirmasi admin"
    },
    "/tempdatasebelumdaftar/{idtempdata}": {
      "schema": "TempDataSebelumDaftar",
      "description": "Koleksi sementara penampung input formulir pendaftaran secara real-time (auto-sync setiap 5 detik) dengan ID unik berbasis perangkat"
    },
    "/system_counters/{counterId}": {
      "schema": "SystemCounter",
      "description": "Koleksi pelacak nomor urut ID anggota unik"
    },
    "/notifications/{notificationId}": {
      "schema": "Notification",
      "description": "Koleksi notifikasi real-time sistem"
    },
    "/activities/{activityId}": {
      "schema": "Activity",
      "description": "Koleksi jadwal dan presensi kegiatan yayasan"
    },
    "/system_logs/{logId}": {
      "schema": "SystemLog",
      "description": "Koleksi catatan seluruh aktivitas aplikasi, log sistem, dan error untuk menu Teknis (IT)"
    }
  }
}
