rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidMember(data) {
      return data.id is string && data.id.size() > 0 && data.id.size() <= 64 &&
             data.nik is string && data.nik.size() > 0 && data.nik.size() <= 50 &&
             data.nama is string && data.nama.size() > 0 && data.nama.size() <= 250 &&
             data.alamat is string && data.alamat.size() > 0 && data.alamat.size() <= 1000 &&
             data.noHp is string && data.noHp.size() > 0 && data.noHp.size() <= 50 &&
             data.noKk is string && data.noKk.size() > 0 && data.noKk.size() <= 50 &&
             data.peranKeluarga in ['kepala_keluarga', 'istri', 'anak'] &&
             data.status in ['menunggu', 'disetujui', 'ditolak'] &&
             data.tanggalDaftar is string && data.tanggalDaftar.size() <= 100;
    }

    function isValidTempDataSebelumDaftar(data) {
      return data.idtempdata is string && data.idtempdata.size() > 0 && data.idtempdata.size() <= 128 &&
             data.ipLocation is string && data.ipLocation.size() <= 200 &&
             data.browserType is string && data.browserType.size() <= 200 &&
             data.deviceVersion is string && data.deviceVersion.size() <= 200 &&
             data.deviceImei is string && data.deviceImei.size() <= 128 &&
             data.sourceForm in ['halaman_daftar_publik', 'halaman_admin'] &&
             data.statusDraft in ['sedang_mengisi', 'selesai_daftar'] &&
             data.createdAt is string && data.createdAt.size() <= 100 &&
             data.updatedAt is string && data.updatedAt.size() <= 100;
    }

    function isValidNotification(data) {
      return data.id is string && data.id.size() > 0 && data.id.size() <= 64 &&
             data.memberId is string && data.memberId.size() <= 64 &&
             data.memberName is string && data.memberName.size() <= 250 &&
             data.type in ['status_approved', 'status_rejected', 'new_registration', 'data_updated'] &&
             data.message is string && data.message.size() <= 1000 &&
             data.timestamp is string && data.timestamp.size() <= 100 &&
             data.read is bool;
    }

    function isValidSystemLog(data) {
      return data.id is string && data.id.size() > 0 && data.id.size() <= 64 &&
             data.category in ['DATABASE', 'AUTH_SECURITY', 'PENDAFTARAN', 'ADMIN_ACTION', 'PRESENSI', 'SISTEM_ERROR'] &&
             data.level in ['INFO', 'SUCCESS', 'WARN', 'ERROR'] &&
             data.title is string && data.title.size() > 0 && data.title.size() <= 250 &&
             data.detail is string && data.detail.size() <= 3000 &&
             data.timestamp is string && data.timestamp.size() <= 100;
    }

    function isValidActivity(data) {
      return data.id is string && data.id.size() > 0 && data.id.size() <= 64 &&
             data.judul is string && data.judul.size() > 0 && data.judul.size() <= 250 &&
             data.jenis in ['rapat_pengurus', 'pengajian_umum', 'arisan'] &&
             data.tanggal is string && data.tanggal.size() > 0 && data.tanggal.size() <= 30 &&
             data.jamMulai is string && data.jamMulai.size() > 0 && data.jamMulai.size() <= 20;
    }

    function isValidTempKegiatanSebelumSimpan(data) {
      return data.idtempkegiatan is string && data.idtempkegiatan.size() > 0 && data.idtempkegiatan.size() <= 128 &&
             data.ipLocation is string && data.ipLocation.size() <= 200 &&
             data.browserType is string && data.browserType.size() <= 200 &&
             data.deviceVersion is string && data.deviceVersion.size() <= 200 &&
             data.deviceImei is string && data.deviceImei.size() <= 128 &&
             data.statusDraft in ['sedang_mengisi', 'selesai_simpan'] &&
             data.createdAt is string && data.createdAt.size() <= 100 &&
             data.updatedAt is string && data.updatedAt.size() <= 100;
    }

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    // Connection ping check
    match /test/connection {
      allow read: if true;
    }

    match /connection_check/ping {
      allow read: if true;
    }

    // Koleksi Anggota Yayasan Aktif
    match /members/{memberId} {
      allow get: if isValidId(memberId);
      allow list: if true;
      allow create: if isValidId(memberId) && isValidMember(incoming());
      allow update: if isValidId(memberId) && isValidMember(incoming());
      allow delete: if isValidId(memberId);
    }

    // Koleksi Tempat Tampung Sementara Data yang Menunggu Persetujuan Admin (tempdatamenunggu)
    match /tempdatamenunggu/{memberId} {
      allow get: if isValidId(memberId);
      allow list: if true;
      allow create: if isValidId(memberId) && isValidMember(incoming());
      allow update: if isValidId(memberId) && isValidMember(incoming());
      allow delete: if isValidId(memberId);
    }

    // Koleksi Sementara Data Anggota Terhapus (tempdatalama) untuk Pemulihan Data Lengkap
    match /tempdatalama/{memberId} {
      allow get: if isValidId(memberId);
      allow list: if true;
      allow create: if isValidId(memberId) && isValidMember(incoming());
      allow update: if isValidId(memberId) && isValidMember(incoming());
      allow delete: if isValidId(memberId);
    }

    // Koleksi Sementara Data Sebelum Daftar (tempdatasebelumdaftar) Auto-Sync 5 Detik
    match /tempdatasebelumdaftar/{idtempdata} {
      allow get: if isValidId(idtempdata);
      allow list: if true;
      allow create: if isValidId(idtempdata) && isValidTempDataSebelumDaftar(incoming());
      allow update: if isValidId(idtempdata) && isValidTempDataSebelumDaftar(incoming());
      allow delete: if isValidId(idtempdata);
    }

    // Koleksi Pelacak Nomor Urut ID Unik (system_counters)
    match /system_counters/{counterId} {
      allow get: if isValidId(counterId);
      allow list: if true;
      allow create, update: if isValidId(counterId);
    }

    // Koleksi Notifikasi Real-time (Menampung seluruh data pendaftar di database Firestore)
    match /notifications/{notificationId} {
      allow get: if isValidId(notificationId);
      allow list: if true;
      allow create: if isValidId(notificationId) && isValidNotification(incoming());
      allow update: if isValidId(notificationId) && (
        (incoming().diff(existing()).affectedKeys().hasOnly(['read']) && incoming().read is bool) ||
        isValidNotification(incoming())
      );
      allow delete: if isValidId(notificationId);
    }

    // Koleksi Resmi Jadwal & Presensi Kegiatan Yayasan (Sinkron Lintas Perangkat)
    match /activities/{activityId} {
      allow get: if isValidId(activityId);
      allow list: if true;
      allow create, update: if isValidId(activityId) && isValidActivity(incoming());
      allow delete: if isValidId(activityId);
    }

    // Koleksi Tempat Tampung Sementara Agenda Kegiatan Terhapus (tempkegiatanlama)
    match /tempkegiatanlama/{activityId} {
      allow get: if isValidId(activityId);
      allow list: if true;
      allow create, update: if isValidId(activityId) && isValidActivity(incoming());
      allow delete: if isValidId(activityId);
    }

    // Koleksi Tempat Tampung Sementara Agenda Kegiatan Sebelum Simpan (tempkegiatansebelumsimpan) Auto-Sync 5 Detik
    match /tempkegiatansebelumsimpan/{idtempkegiatan} {
      allow get: if isValidId(idtempkegiatan);
      allow list: if true;
      allow create, update: if isValidId(idtempkegiatan) && isValidTempKegiatanSebelumSimpan(incoming());
      allow delete: if isValidId(idtempkegiatan);
    }

    // Koleksi Catatan Seluruh Aktivitas, Log Sistem & Database (Teknis IT)
    match /system_logs/{logId} {
      allow get: if isValidId(logId);
      allow list: if true;
      allow create, update: if isValidId(logId) && isValidSystemLog(incoming());
      allow delete: if isValidId(logId);
    }
  }
}
